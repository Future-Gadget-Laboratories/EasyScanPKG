# Copy to ~/.config/sft/sonar.env and fill in. Never commit real tokens.
# Connected mode (preferred when available):
SONARQUBE_TOKEN=
SONARQUBE_URL=
# SONARQUBE_ORG=   # SonarQube Cloud only
# SONARQUBE_PROJECT_KEY=

# Optional IDE bridge (also auto-detected on ports 64120-64130):
# SONARQUBE_IDE_PORT=

# Optional tool policy:
# SONARQUBE_TOOLSETS=analysis,ide,issues,projects,quality-gates,rules,security-hotspots
# SONARQUBE_READ_ONLY=false
