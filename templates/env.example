# Remote credentials → copy to ~/.config/sft/sonar.env (never commit real tokens).
# Or run:  bin/sonar-credentials --cli --test
SONARQUBE_TOKEN=
SONARQUBE_URL=
# SONARQUBE_ORG=   # SonarQube Cloud only
# SONARQUBE_PROJECT_KEY=

# Local agent credentials are separate (auto-managed):
#   ~/.config/sft/sonar-local.env
# Mint / refresh with:
#   bin/sonar-credentials --local --bootstrap --test
#   bin/sonar-credentials --local --cli --test
#   bin/sonar-local-up

# Optional IDE bridge (also auto-detected on ports 64120-64130):
# SONARQUBE_IDE_PORT=

# Optional tool policy:
# SONARQUBE_TOOLSETS=analysis,ide,issues,projects,quality-gates,rules,security-hotspots
# SONARQUBE_READ_ONLY=false
