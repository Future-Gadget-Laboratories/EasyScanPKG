{
  "project_key": "example.project",
  "connection": {
    "prefer_connected": true
  },
  "scan": {
    "max_files_per_analyze": 40,
    "scanners": {
      "sonar": { "enabled": true },
      "clang-tidy": {
        "enabled": false,
        "compile_commands": "build/compile_commands.json"
      },
      "drmemory": {
        "enabled": false,
        "command": ["./build/tests"]
      },
      "cppcheck": { "enabled": false },
      "ruff": { "enabled": false, "paths": ["lib", "bin", "hooks"] },
      "shellcheck": { "enabled": false },
      "semgrep": { "enabled": false, "config": "p/default" },
      "bandit": { "enabled": false },
      "asan": { "enabled": false, "command": null },
      "ubsan": { "enabled": false, "command": null },
      "valgrind": { "enabled": false, "command": null },
      "gitleaks": { "enabled": false, "no_git": true },
      "pip-audit": { "enabled": false },
      "osv": { "enabled": false },
      "flawfinder": { "enabled": false },
      "clang-analyzer": { "enabled": false },
      "hadolint": { "enabled": false }
    }
  },
  "agent": {
    "must_analyze_on_task_end": true
  },
  "hook": {
    "after_file_edit_enabled": true,
    "fail_open": true
  }
}
