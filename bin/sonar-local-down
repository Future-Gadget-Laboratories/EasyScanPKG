#!/usr/bin/env python3
"""Stop local SonarQube Docker fallback server.

Containers and volumes are kept by default (plain `stop`). Pass --remove to
remove the containers (`compose down`); volumes are never removed here.

It refuses while on-demand leases are active (a scan is using the server)
unless --force. --if-idle only reaps stale leases and stops a server that
on-demand leases started and nobody uses any more (safe from cron).
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from local_server import stop  # noqa: E402
from sonar_lease import stop_guard, stop_if_idle  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    parser.add_argument(
        "--remove",
        action="store_true",
        help="also remove the containers (compose down); volumes are kept",
    )
    parser.add_argument(
        "--if-idle",
        action="store_true",
        help="only stop a server started by on-demand leases once no lease is left",
    )
    parser.add_argument("--force", action="store_true", help="stop even while leases are active")
    args = parser.parse_args()
    if args.if_idle:
        print(f"on-demand SonarQube: {stop_if_idle()}")
        return 0
    try:
        with stop_guard(force=args.force):
            st = stop(remove=args.remove)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    payload = {"ok": True, "running": st.running, "url": st.url, "removed": args.remove}
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print("local SonarQube containers removed" if args.remove else "local SonarQube stopped")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
