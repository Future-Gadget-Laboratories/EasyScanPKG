#!/usr/bin/env python3
"""Set or update remote SonarQube URL and user token."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from env_load import apply_sonar_env
from env_write import read_env_file, update_remote_credentials, REMOTE_ENV
from merge_codex_config import merge_codex_config
from merge_cursor_mcp import merge_mcp_config
from prompt_credentials import prompt_credentials
from server_health import AuthStatus, check_server


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--test", action="store_true", help="Validate after save")
    parser.add_argument("--cli", action="store_true", help="Use terminal prompts (skip GUI dialog)")
    parser.add_argument("--url", help="Set URL without prompting")
    parser.add_argument("--token", help="Set token without prompting")
    args = parser.parse_args()

    apply_sonar_env()
    remote = read_env_file(REMOTE_ENV)
    url_default = remote.get("SONARQUBE_URL") or os.environ.get("SONARQUBE_URL", "http://127.0.0.1:9000")

    if args.url and args.token:
        creds_url, creds_token = args.url, args.token
    else:
        if args.cli:
            os.environ["SFT_SONAR_CLI_PROMPT"] = "1"
        creds = prompt_credentials(url_default=url_default, prefer_cli=args.cli)
        if creds.cancelled:
            print("Cancelled — no credentials saved.", file=sys.stderr)
            print(f"Tip: run with --cli, or edit {REMOTE_ENV}", file=sys.stderr)
            print("     SONARQUBE_URL=https://sonar.example.com", file=sys.stderr)
            print("     SONARQUBE_TOKEN=<your-user-token>", file=sys.stderr)
            return 1
        creds_url, creds_token = creds.url, creds.token

    if not creds_url or not creds_token:
        print("URL and token are both required.", file=sys.stderr)
        return 1

    update_remote_credentials(url=creds_url, token=creds_token)
    os.environ["SONARQUBE_URL"] = creds_url
    os.environ["SONARQUBE_TOKEN"] = creds_token
    merge_mcp_config()
    merge_codex_config()

    payload = {"ok": True, "url": creds_url, "saved_to": str(REMOTE_ENV)}
    if args.test:
        health = check_server(creds_url, creds_token)
        payload["auth_status"] = health.status.value
        payload["detail"] = health.detail
        if health.status != AuthStatus.OK:
            payload["ok"] = False

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"Saved credentials to {REMOTE_ENV}")
        if args.test:
            print(f"  validate: {payload.get('auth_status')} — {payload.get('detail')}")
    return 0 if payload["ok"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
