#!/usr/bin/env python3
"""Set or update SonarQube URL and user token (remote or local).

Remote (default): ~/.config/sft/sonar.env
Local (--local):  ~/.config/sft/sonar-local.env

Agents: prefer --local --bootstrap to mint a token from the local Docker
SonarQube, or pass --local --url … --token … when you already have one.
Never print the token value into chat.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from credentials_set import (  # noqa: E402
    credential_paths,
    mask_token_present,
    set_local_credentials,
    set_remote_credentials,
)
from env_load import apply_sonar_env  # noqa: E402
from env_write import LOCAL_ENV, REMOTE_ENV  # noqa: E402


def _print_result(payload: dict, *, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2))
        return
    if payload.get("detail") == "cancelled":
        target = payload.get("saved_to", "")
        print("Cancelled — no credentials saved.", file=sys.stderr)
        print(f"Tip: run with --cli, or edit {target}", file=sys.stderr)
        print("     SONARQUBE_URL=…", file=sys.stderr)
        print("     SONARQUBE_TOKEN=<your-user-token>", file=sys.stderr)
        return
    print(f"Saved {payload.get('backend')} credentials to {payload.get('saved_to')}")
    if payload.get("bootstrapped"):
        print("  bootstrapped: local user token generated via API")
    if payload.get("project_key"):
        print(f"  project_key: {payload['project_key']}")
    if payload.get("auth_status") is not None:
        print(f"  validate: {payload.get('auth_status')} — {payload.get('detail')}")


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--local",
        action="store_true",
        help="Write local agent token to ~/.config/sft/sonar-local.env",
    )
    parser.add_argument(
        "--bootstrap",
        action="store_true",
        help="With --local: start local Sonar if needed and mint a user token",
    )
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--test", action="store_true", help="Validate after save")
    parser.add_argument("--cli", action="store_true", help="Use terminal prompts (skip GUI)")
    parser.add_argument("--url", help="Set URL without prompting")
    parser.add_argument("--token", help="Set token without prompting")
    parser.add_argument(
        "--project-key",
        help="Optional SONARQUBE_PROJECT_KEY (local env / bootstrap)",
    )
    parser.add_argument(
        "--paths",
        action="store_true",
        help="Print credential file paths (no secrets) and exit",
    )
    args = parser.parse_args()

    apply_sonar_env()

    if args.paths:
        payload = credential_paths()
        payload["local_token_present"] = mask_token_present(LOCAL_ENV)
        payload["remote_token_present"] = mask_token_present(REMOTE_ENV)
        if args.json:
            print(json.dumps(payload, indent=2))
        else:
            print(f"local:  {payload['local_env']}  (exists={payload['local_exists']}, token={payload['local_token_present']})")
            print(f"remote: {payload['remote_env']}  (exists={payload['remote_exists']}, token={payload['remote_token_present']})")
        return 0

    if args.bootstrap and not args.local:
        print("--bootstrap requires --local", file=sys.stderr)
        return 2

    if args.local:
        result = set_local_credentials(
            url=args.url,
            token=args.token,
            project_key=args.project_key,
            bootstrap=args.bootstrap,
            prefer_cli=args.cli,
            validate=args.test,
        )
    else:
        if args.project_key:
            print("--project-key is only used with --local", file=sys.stderr)
            return 2
        result = set_remote_credentials(
            url=args.url,
            token=args.token,
            prefer_cli=args.cli,
            validate=args.test,
        )

    payload = {
        "ok": result.ok,
        "url": result.url,
        "saved_to": result.saved_to,
        "backend": result.backend,
        "auth_status": result.auth_status,
        "detail": result.detail,
        "bootstrapped": result.bootstrapped,
        "project_key": result.project_key,
    }
    # Never include the token in JSON/stdout.
    _print_result(payload, as_json=args.json)
    if result.detail == "cancelled":
        return 1
    return 0 if result.ok else 2


if __name__ == "__main__":
    raise SystemExit(main())
