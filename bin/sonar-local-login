#!/usr/bin/env python3
"""Print the Sonar UI login for the server on this machine.

The password in ~/.config/sft/sonar-local-admin.json only matches the
Docker Sonar bound to 127.0.0.1:9000 here. A password from a cloud agent
or any other host is rejected by your local server.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from local_server import local_ui_login  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    try:
        info = local_ui_login()
    except RuntimeError as exc:
        print(f"local login: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(info, indent=2))
        return 0
    print("Local Sonar UI login (this machine only):")
    print(f"  url:      {info['url']}")
    print(f"  username: {info['username']}")
    print(f"  password: {info['password']}")
    print(f"  saved in: {info['state_file']}")
    print("Open that URL on this computer. Do not reuse this password on a remote Sonar server.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
