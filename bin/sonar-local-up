#!/usr/bin/env python3
"""Start local SonarQube Docker fallback server."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from local_credentials import credential_paths  # noqa: E402
from local_server import admin_login, ensure_local_credential_series, ensure_token, start  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    st = start(wait=True)
    token = ensure_token()
    login = admin_login()
    series = ensure_local_credential_series()
    series["directory"] = credential_paths()["directory"]
    payload = {
        "ok": True,
        "running": st.running,
        "url": st.url,
        "token_bootstrapped": bool(token),
        "admin_username": login["username"],
        "admin_password": login["password"],
        "admin_state_file": login["state_file"],
        "local_credentials": {
            "directory": series["directory"],
            "active": series.get("active"),
            "local_only": True,
            "entries": [
                {
                    "name": entry.get("name"),
                    "kind": entry.get("kind"),
                    "active": entry.get("active"),
                    "token_present": entry.get("token_present"),
                }
                for entry in series.get("entries") or []
            ],
        },
    }
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"local SonarQube: {st.url} running={st.running}")
        print("UI login (open in a browser):")
        print(f"  url:      {login['url']}")
        print(f"  username: {login['username']}")
        if login["password"]:
            print(f"  password: {login['password']}")
        else:
            print("  password: (not set yet — check boot logs)")
        print(f"  saved in: {login['state_file']}")
        creds = payload["local_credentials"]
        print(f"Local-only credential series: {creds['directory']}")
        print(f"  active: {creds.get('active') or '(none)'}")
        for entry in creds["entries"]:
            flag = "active" if entry.get("active") else "stored"
            print(f"  {entry.get('name'):<10} {entry.get('kind'):<24} {flag}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
