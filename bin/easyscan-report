#!/usr/bin/env python3
"""Readable scan report from the exported issue checklist (no network calls).

Reads .sft/issue-checklist.json (written by easyscan-scan or sonar-issues export)
and writes an HTML and/or markdown report grouped by file then rule, then prints
a compact terminal summary. Exit 3 when --fail-on-severity finds an open issue.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from easyscan_report import (
    FORMATS,
    ReportError,
    build_report,
    changed_files,
    load_checklist,
    load_remediation,
    render_terminal,
    write_reports,
)
from scanners.gate import parse_threshold


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", default=".", help="Project root (default: cwd)")
    parser.add_argument(
        "--input",
        help="Checklist JSON (default: <workspace>/.sft/issue-checklist.json)",
    )
    parser.add_argument(
        "--out-dir",
        help="Report directory (default: <workspace>/.sft/report)",
    )
    parser.add_argument(
        "--format",
        choices=FORMATS,
        default="both",
        help="Files to write: html, markdown, or both (default)",
    )
    parser.add_argument(
        "--changed-from",
        metavar="GIT_REF",
        help="Add a 'new in changed files' section: findings in files that differ from GIT_REF",
    )
    parser.add_argument(
        "--fail-on-severity",
        metavar="LEVEL",
        default=os.environ.get("EASYSCAN_FAIL_ON_SEVERITY") or None,
        help="Exit 3 if any open finding is at or above LEVEL (info, low/minor, medium/major, "
        "high/critical, blocker). Env: EASYSCAN_FAIL_ON_SEVERITY",
    )
    parser.add_argument("--top", type=int, default=5, help="Top files in the terminal summary")
    args = parser.parse_args(argv)

    threshold = None
    if args.fail_on_severity:
        try:
            threshold = parse_threshold(args.fail_on_severity)
        except ValueError as exc:
            parser.error(str(exc))

    workspace = Path(args.workspace).resolve()
    input_path = Path(args.input) if args.input else workspace / ".sft" / "issue-checklist.json"
    out_dir = Path(args.out_dir) if args.out_dir else workspace / ".sft" / "report"
    try:
        checklist = load_checklist(input_path)
        changed = changed_files(workspace, args.changed_from) if args.changed_from else None
        report = build_report(
            checklist,
            remediation=load_remediation(),
            changed_from=args.changed_from,
            changed=changed,
            threshold=threshold,
            top=args.top,
        )
        written = write_reports(report, out_dir, args.format)
    except ReportError as exc:
        print(f"easyscan-report: {exc}", file=sys.stderr)
        return 2

    sys.stdout.write(render_terminal(report))
    for path in written:
        print(f"Wrote: {path}")
    if threshold and report["failing"]:
        return 3
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
