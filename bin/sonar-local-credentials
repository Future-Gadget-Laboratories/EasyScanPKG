#!/usr/bin/env python3
"""Store and switch a series of local-only Sonar credentials.

Credentials are written under ~/.config/sft/credentials/ (mode 600).
Only loopback URLs are accepted. Token values are never printed.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from local_credentials import (  # noqa: E402
    LocalCredentialError,
    credential_paths,
    public_catalog,
    store_local_credential,
    use_local_credential,
)
from local_server import ensure_local_credential_series  # noqa: E402


def _print(payload: dict, *, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2))
        return
    print(f"local credentials: {payload.get('directory', '')}")
    print(f"  active: {payload.get('active') or '(none)'}")
    entries = payload.get("entries") or []
    if not entries:
        print("  (empty — run: sonar-local-credentials bootstrap)")
        return
    for entry in entries:
        flag = "active" if entry.get("active") else "stored"
        present = "token" if entry.get("token_present") else "NO TOKEN"
        print(
            f"  {entry.get('name'):<10} {entry.get('kind'):<24} {flag:<8} {present}"
            f"  {entry.get('url')}"
        )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("list", help="List stored local credentials (no secrets)")
    sub.add_parser("paths", help="Print credential directory paths")
    sub.add_parser("bootstrap", help="Mint agent, scanner, and issues tokens on local Sonar")

    use_p = sub.add_parser("use", help="Activate a stored credential in sonar-local.env")
    use_p.add_argument("name")

    store_p = sub.add_parser("store", help="Save one loopback credential")
    store_p.add_argument("--name", required=True)
    store_p.add_argument("--url", required=True)
    store_p.add_argument("--token", required=True)
    store_p.add_argument("--kind", default="USER_TOKEN")
    store_p.add_argument("--project-key")
    store_p.add_argument("--purpose", default="manually stored local credential")
    store_p.add_argument("--activate", action="store_true")

    args = parser.parse_args()
    command = args.command or "list"

    try:
        if command == "paths":
            payload = credential_paths()
            payload["local_only"] = True
            if args.json:
                print(json.dumps(payload, indent=2))
            else:
                for key, value in payload.items():
                    print(f"{key}: {value}")
            return 0
        if command == "bootstrap":
            payload = ensure_local_credential_series()
            payload["directory"] = credential_paths()["directory"]
            payload["ok"] = True
            _print(payload, as_json=args.json)
            return 0
        if command == "use":
            row = use_local_credential(args.name)
            payload = public_catalog()
            payload["used"] = row.name
            payload["ok"] = True
            _print(payload, as_json=args.json)
            return 0
        if command == "store":
            store_local_credential(
                args.name,
                args.url,
                args.token,
                kind=args.kind,
                project_key=args.project_key,
                purpose=args.purpose,
                activate=args.activate,
            )
            payload = public_catalog()
            payload["ok"] = True
            _print(payload, as_json=args.json)
            return 0
        payload = public_catalog()
        payload["ok"] = True
        _print(payload, as_json=args.json)
        return 0
    except LocalCredentialError as exc:
        print(f"local credentials: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
