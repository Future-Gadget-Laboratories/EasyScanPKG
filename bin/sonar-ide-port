#!/usr/bin/env python3
"""Detect SonarQube for IDE HTTP port and record it in the policy DB."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from ide_port import diagnose_ide_bridge, find_ide_port, install_ide_extension  # noqa: E402
from policy_db import resolve_store  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", default=os.getcwd())
    parser.add_argument("--json", action="store_true")
    parser.add_argument(
        "--export-env",
        action="store_true",
        help="Print SONARQUBE_IDE_PORT=... for shell eval",
    )
    parser.add_argument(
        "--install",
        action="store_true",
        help="Install SonarQube for IDE extension via cursor CLI",
    )
    args = parser.parse_args()

    if args.install:
        ok, message = install_ide_extension()
        if args.json:
            print(json.dumps({"ok": ok, "message": message}, indent=2))
        else:
            print(message)
        return 0 if ok else 1

    store = resolve_store()
    diagnosis = diagnose_ide_bridge()
    ide = find_ide_port() if diagnosis.ok else None
    if ide:
        store.upsert_workspace(args.workspace, last_ide_port=ide.port)
        store.record_event(
            "ide_port_found",
            {"port": ide.port, "ide_name": ide.ide_name, "workspace": args.workspace},
        )
        if args.export_env:
            print(f"export SONARQUBE_IDE_PORT={ide.port}")
            return 0
        payload = {"ok": True, "port": ide.port, "ide_name": ide.ide_name}
        if args.json:
            print(json.dumps(payload, indent=2))
        else:
            print(f"{ide.port}\t{ide.ide_name or ''}")
        return 0

    store.record_event("ide_port_missing", {"workspace": args.workspace, "detail": diagnosis.detail})
    if args.export_env:
        return 1
    if args.json:
        print(
            json.dumps(
                {
                    "ok": False,
                    "port": None,
                    "extension_installed": diagnosis.extension_installed,
                    "detail": diagnosis.detail,
                    "hint": diagnosis.hint,
                },
                indent=2,
            )
        )
    else:
        print(diagnosis.detail, file=sys.stderr)
        if diagnosis.hint:
            print(diagnosis.hint, file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
