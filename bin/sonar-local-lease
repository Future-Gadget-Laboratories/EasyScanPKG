#!/usr/bin/env python3
"""Run a command while holding an on-demand local SonarQube lease.

    sonar-local-lease -- ./my-scan.sh args...
    sonar-local-lease --status

Starts sft-sonarqube (and its database) if needed, waits for UP, runs the
command, then releases the lease; the last lease out stops the stack (stop
only: containers and volumes are kept). Works whether or not
SFT_SONAR_ON_DEMAND is set: using this wrapper is the opt-in.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from sonar_lease import active_leases, lease  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--status", action="store_true", help="print active leases and exit")
    parser.add_argument("--purpose", default="sonar-local-lease", help="label shown in --status")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.status:
        print(json.dumps(active_leases(), indent=2, sort_keys=True))
        return 0
    cmd = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not cmd:
        parser.error("give a command after --")
    with lease(args.purpose, enabled=True):
        return subprocess.call(cmd)


if __name__ == "__main__":
    raise SystemExit(main())
