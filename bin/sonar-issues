#!/usr/bin/env python3
"""List and resolve SonarQube issues on the local or remote server."""

from __future__ import annotations

import argparse
import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from env_load import apply_sonar_env  # noqa: E402
from env_write import LOCAL_ENV, REMOTE_ENV, read_env_file  # noqa: E402
from local_server import DEFAULT_LOCAL_URL, ensure_token, is_running, start  # noqa: E402


def _auth_header(token: str) -> str:
    return "Basic " + base64.b64encode(f"{token}:".encode()).decode("ascii")


def _api(base: str, token: str, method: str, path: str, query: dict | None = None) -> tuple[int, dict | str]:
    url = base.rstrip("/") + path
    if query:
        url += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
    req = urllib.request.Request(url, method=method)
    req.add_header("Authorization", _auth_header(token))
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read().decode("utf-8")
            try:
                return resp.status, json.loads(body) if body else {}
            except json.JSONDecodeError:
                return resp.status, body
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            return exc.code, json.loads(body) if body else {}
        except json.JSONDecodeError:
            return exc.code, body


def _creds(*, prefer_local: bool) -> tuple[str, str, str | None]:
    apply_sonar_env()
    local = read_env_file(LOCAL_ENV)
    remote = read_env_file(REMOTE_ENV)
    if prefer_local:
        if not is_running():
            start(wait=True)
        token = ensure_token()
        url = local.get("SONARQUBE_URL") or DEFAULT_LOCAL_URL
        key = local.get("SONARQUBE_PROJECT_KEY") or os.environ.get("SONARQUBE_PROJECT_KEY")
        return url, token, key
    url = os.environ.get("SONARQUBE_URL") or remote.get("SONARQUBE_URL") or local.get("SONARQUBE_URL") or DEFAULT_LOCAL_URL
    token = os.environ.get("SONARQUBE_TOKEN") or remote.get("SONARQUBE_TOKEN") or local.get("SONARQUBE_TOKEN")
    key = (
        os.environ.get("SONARQUBE_PROJECT_KEY")
        or remote.get("SONARQUBE_PROJECT_KEY")
        or local.get("SONARQUBE_PROJECT_KEY")
    )
    if not token:
        if url.startswith(("http://127.0.0.1", "http://localhost")):
            if not is_running():
                start(wait=True)
            return (local.get("SONARQUBE_URL") or DEFAULT_LOCAL_URL), ensure_token(), key
        raise SystemExit("No SONARQUBE_TOKEN")
    return url, token, key


def _fmt_issue(issue: dict) -> str:
    comp = (issue.get("component") or "").split(":")[-1]
    return (
        f"[{issue.get('severity')}/{issue.get('type')}] "
        f"{issue.get('key')}  {comp}:{issue.get('line', '-')}  "
        f"{issue.get('message', '')}  ({issue.get('rule')})"
    )


def cmd_list(args: argparse.Namespace) -> int:
    url, token, default_key = _creds(prefer_local=args.local)
    key = args.project_key or default_key
    if not key:
        print("Need --project-key", file=sys.stderr)
        return 2
    query = {
        "componentKeys": key,
        "ps": args.limit,
        "resolved": "false" if not args.resolved else "true",
        "severities": args.severity,
        "types": args.type,
        "facets": "severities,types,rules",
    }
    code, data = _api(url, token, "GET", "/api/issues/search", query)
    if code != 200 or not isinstance(data, dict):
        print(f"search failed: HTTP {code} {data}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(data, indent=2))
        return 0
    print(f"Server: {url}")
    print(f"Project: {key}  open/matching issues: {data.get('total', 0)}")
    for facet in data.get("facets", []):
        vals = [f"{v['val']}={v['count']}" for v in facet.get("values", []) if v.get("count")]
        if vals:
            print(f"  {facet.get('property')}: {', '.join(vals)}")
    print()
    for issue in data.get("issues", []):
        print(_fmt_issue(issue))
    print(f"\nUI: {url}/project/issues?id={urllib.parse.quote(key)}&resolved=false")
    return 0


def cmd_transitions(args: argparse.Namespace) -> int:
    url, token, _ = _creds(prefer_local=args.local)
    code, data = _api(url, token, "GET", "/api/issues/transitions", {"issue": args.issue})
    if code != 200 or not isinstance(data, dict):
        print(f"transitions failed: HTTP {code} {data}", file=sys.stderr)
        return 1
    transitions = [t.get("transition") or t for t in data.get("transitions", [])]
    if args.json:
        print(json.dumps({"issue": args.issue, "transitions": transitions}, indent=2))
    else:
        print("Available:", ", ".join(str(t) for t in transitions) or "(none)")
    return 0


def cmd_resolve(args: argparse.Namespace) -> int:
    url, token, _ = _creds(prefer_local=args.local)
    transition = args.transition
    # Prefer modern Accept workflow when user said "resolve" but only accept exists
    code, data = _api(url, token, "GET", "/api/issues/transitions", {"issue": args.issue})
    available = []
    if code == 200 and isinstance(data, dict):
        available = [t.get("transition") or t for t in data.get("transitions", [])]
        available = [str(t) for t in available]
    if transition not in available and available:
        for fallback in ("resolve", "accept", "wontfix", "falsepositive"):
            if fallback in available:
                if transition == "resolve" and fallback != "resolve":
                    print(f"note: using transition '{fallback}' (resolve not available)", file=sys.stderr)
                transition = fallback
                break
    code, body = _api(
        url,
        token,
        "POST",
        "/api/issues/do_transition",
        {"issue": args.issue, "transition": transition},
    )
    ok = code == 200
    if args.json:
        print(json.dumps({"ok": ok, "http": code, "transition": transition, "body": body}, indent=2))
    else:
        if ok:
            print(f"OK: {args.issue} -> {transition}")
        else:
            print(f"FAILED HTTP {code}: {body}", file=sys.stderr)
            if available:
                print(f"Available transitions: {', '.join(available)}", file=sys.stderr)
    return 0 if ok else 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--local", action="store_true")
    parser.add_argument("--json", action="store_true")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_list = sub.add_parser("list", help="List issues")
    p_list.add_argument("--project-key")
    p_list.add_argument("--limit", type=int, default=50)
    p_list.add_argument("--severity", help="Comma list e.g. CRITICAL,MAJOR")
    p_list.add_argument("--type", dest="type", help="Comma list e.g. BUG,VULNERABILITY,CODE_SMELL")
    p_list.add_argument("--resolved", action="store_true", help="Show resolved instead of open")

    p_tr = sub.add_parser("transitions", help="Show allowed transitions for an issue key")
    p_tr.add_argument("issue")

    p_res = sub.add_parser("resolve", help="Transition an issue (resolve/accept/wontfix/falsepositive)")
    p_res.add_argument("issue")
    p_res.add_argument(
        "--transition",
        default="resolve",
        help="Transition name (default: resolve; falls back to accept if needed)",
    )

    args = parser.parse_args()
    if args.cmd == "list":
        return cmd_list(args)
    if args.cmd == "transitions":
        return cmd_transitions(args)
    if args.cmd == "resolve":
        return cmd_resolve(args)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
