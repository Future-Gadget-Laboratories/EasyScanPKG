#!/usr/bin/env python3
"""Verify EasyScanPKG install readiness (exit 1 on hard failures)."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _bootstrap import bootstrap

bootstrap()

from easyscan_check import report_to_dict, run_checks  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--offline", action="store_true", help="Skip docker pulls / local server hard fails")
    parser.add_argument("--require-local", action="store_true", help="Require local Sonar UP + token")
    parser.add_argument("--quick", action="store_true", help="Fast subset for desktop launcher")
    parser.add_argument("--pull-images", action="store_true", help="docker pull missing images")
    parser.add_argument("--skip-tests", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    report = run_checks(
        offline=args.offline,
        require_local=args.require_local,
        quick=args.quick,
        pull_images=args.pull_images,
        skip_tests=args.skip_tests,
    )
    if args.json:
        print(json.dumps(report_to_dict(report), indent=2))
    else:
        print(f"EasyScanPKG check — root={report.root}")
        for item in report.items:
            mark = "OK" if item.ok else ("WARN" if item.level == "soft" else "FAIL")
            print(f"  [{mark}] {item.id}: {item.detail}")
        print("PASS" if report.ok else "FAIL")
    return 0 if report.ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
